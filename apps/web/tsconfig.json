{
  "extends": "@formfillai/tsconfig/next",
  "compilerOptions": {
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@formfillai/shared": [
        "../../packages/shared/src/index"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    }
  ]
}
